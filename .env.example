# Public application URL
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3002

# Supabase Auth: public project URL and publishable key (never a secret/service-role key).
NEXT_PUBLIC_SUPABASE_URL=
# Preferred current public key; legacy anon key below is a fallback only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Integration tests only: empty loopback PostgreSQL database named mocvi_test_*
# Export in the shell before pnpm test:db; the test script does not load .env.local.
TEST_DATABASE_URL=

# Server-only production opt-in. Requires the approved HTTPS site and project ref.
BOOKING_MUTATIONS_ENABLED=false
# Local integration gate; never enables cloud deployment by itself.
# For isolated development integration, the project ref must be the approved
# development project and the application must run on a loopback URL.
BOOKING_LOCAL_MUTATIONS_ENABLED=false
BOOKING_ALLOWED_SUPABASE_PROJECT_REF=

# Transactional email (configured in a later phase)
RESEND_API_KEY=
